# Backend Configuration
SECRET_KEY=your-secret-key-change-in-production-use-random-string
DATABASE_URL=sqlite:///chatbot.db
FLASK_ENV=production
OLLAMA_HOST=http://ollama:11434

# OAuth Configuration (optional - set if using OAuth)
# SERVER_NAME=your-domain.com
# PREFERRED_URL_SCHEME=https
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# For production deployment:
# 1. Change SECRET_KEY to a secure random string
# 2. Set SERVER_NAME to your domain (e.g., example.com or example.com:80)
# 3. Set PREFERRED_URL_SCHEME to https if using SSL/TLS
